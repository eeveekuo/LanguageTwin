rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared decks library: all users (including guests) can read shared decks; creation and cleanup allowed.
    match /decks/{deckId} {
      allow read, write: if true;
    }

    // User profiles & sync data: private to the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
