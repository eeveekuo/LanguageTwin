{
  "entities": {
    "Deck": {
      "title": "Shared and Custom Flashcard Decks",
      "description": "Shared and user-created custom flashcard decks with frequency rankings and rich example sentences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "targetLang": { "type": "string" },
        "targetLangCode": { "type": "string" },
        "knownLang": { "type": "string" },
        "knownLangCode": { "type": "string" },
        "level": { "type": "string" },
        "cards": { "type": "array" },
        "createdAt": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorPhoto": { "type": "string" },
        "isCustom": { "type": "boolean" },
        "cardsCount": { "type": "number" }
      },
      "required": ["id", "title", "targetLangCode"]
    },
    "UserProfile": {
      "title": "User Study Progress",
      "description": "Individual learner profile, daily streak, active deck, compact card SRS states, and custom decks",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "targetLangCode": { "type": "string" },
        "knownLangCode": { "type": "string" },
        "activeDeckId": { "type": "string" },
        "dailyProgress": { "type": "object" },
        "streak": { "type": "number" },
        "cardSRSMap": { "type": "object" },
        "customDecks": { "type": "array" },
        "errorRemedyDeck": { "type": "object" },
        "journalEntries": { "type": "array" },
        "lastSyncedAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "JournalEntry": {
      "title": "Language Journal Entry",
      "description": "User freeform prose entries, timestamps, tags, and AI error checking corrections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "targetLangCode": { "type": "string" },
        "targetLangName": { "type": "string" },
        "knownLangCode": { "type": "string" },
        "knownLangName": { "type": "string" },
        "tags": { "type": "array" },
        "wordCount": { "type": "number" },
        "characterCount": { "type": "number" },
        "promptTopic": { "type": "string" },
        "mood": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "correctionResult": { "type": "object" }
      },
      "required": ["id", "content", "date", "targetLangCode"]
    }
  },
  "firestore": {
    "/decks/{deckId}": {
      "schema": "Deck",
      "description": "Shared and user-created custom flashcard decks"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile, daily streak, active settings, compact card SRS states, and custom decks"
    }
  }
}
