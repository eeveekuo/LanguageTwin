{
  "entities": {
    "Deck": {
      "title": "Shared and Generated Decks",
      "description": "Shared library of AI generated and custom decks available for all users to study and reuse",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "targetLang": { "type": "string" },
        "targetLangCode": { "type": "string" },
        "knownLang": { "type": "string" },
        "knownLangCode": { "type": "string" },
        "level": { "type": "string" },
        "cards": { "type": "array" },
        "createdAt": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorPhoto": { "type": "string" },
        "isCustom": { "type": "boolean" },
        "usageCount": { "type": "number" }
      },
      "required": ["id", "title", "targetLangCode", "cards"]
    },
    "UserProfile": {
      "title": "User Study Progress",
      "description": "Individual learner profile, daily streak, active deck, and SM-2 spaced repetition state",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "targetLangCode": { "type": "string" },
        "knownLangCode": { "type": "string" },
        "activeDeckId": { "type": "string" },
        "dailyProgress": { "type": "object" },
        "progressHistory": { "type": "array" },
        "errorRemedyDeck": { "type": "object" },
        "journalEntries": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "JournalEntry": {
      "title": "Language Journal Entry",
      "description": "User freeform prose entries, timestamps, tags, and AI error checking corrections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "targetLangCode": { "type": "string" },
        "targetLangName": { "type": "string" },
        "knownLangCode": { "type": "string" },
        "knownLangName": { "type": "string" },
        "tags": { "type": "array" },
        "wordCount": { "type": "number" },
        "characterCount": { "type": "number" },
        "promptTopic": { "type": "string" },
        "mood": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "correctionResult": { "type": "object" }
      },
      "required": ["id", "content", "date", "targetLangCode"]
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
